{
  "name": "media-compressor",
  "version": "1.0.0",
  "description": "Compress images and videos for the web without losing quality: pixel-exact images, VMAF-checked video, WebP / AVIF / WebM output.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "compress": "tsx bin/compress.ts",
    "images": "tsx bin/compress.ts images",
    "images:webp": "tsx bin/compress.ts images --webp",
    "videos": "tsx bin/compress.ts videos",
    "videos:webm": "tsx bin/compress.ts videos --webm",
    "web": "tsx bin/compress.ts all --webp --webm",
    "typecheck": "next typegen && tsc",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "motion": "^14.4.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
